generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model coolers {
  id         Int      @id @default(autoincrement())
  name       String
  price      Decimal? @db.Decimal(10, 2)
  rpm        Int?
  noise      Decimal? @db.Decimal(5, 2)
  color      String?
  size       Int?
  imagen_url String?
  tipo       String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Cooler")
}

model cpus {
  id          Int      @id @default(autoincrement())
  name        String
  price       Decimal? @db.Decimal(10, 2)
  core_count  Int
  core_clock  Decimal  @db.Decimal(4, 2)
  boost_clock Decimal? @db.Decimal(4, 2)
  tdp         Int
  graphics    String?
  smt         Boolean
  imagen_url  String?
  tipo        String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Cpu")
}

model fuentes {
  id         Int      @id @default(autoincrement())
  name       String
  price      Decimal? @db.Decimal(10, 2)
  type       String?
  efficiency String?
  wattage    Int?
  modular    String?
  color      String?
  imagen_url String?
  tipo       String?  @default("fuentes")

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Fuente")
}

model gabinetes {
  id               Int      @id @default(autoincrement())
  name             String
  price            Decimal? @db.Decimal(10, 2)
  type             String?
  color            String?
  psu              String?
  side_panel       String?
  external_volume  Decimal? @db.Decimal(5, 2)
  internal_35_bays Int?
  imagen_url       String?
  tipo             String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Gabinete")
}

model graficas {
  id          Int      @id @default(autoincrement())
  name        String
  price       Decimal? @db.Decimal(10, 2)
  chipset     String?
  memory      Int?
  core_clock  Int?
  boost_clock Int?
  color       String?
  length      Int?
  imagen_url  String?
  tipo        String?  @default("graficas")

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Grafica")
}

model memorias_externas {
  id           Int      @id @default(autoincrement())
  name         String
  price        Decimal? @db.Decimal(10, 2)
  type         String?
  interface    String?
  capacity     Int?
  price_per_gb Decimal? @db.Decimal(10, 3)
  color        String?
  imagen_url   String?
  tipo         String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_MemoriaExterna")
}

model memorias_internas {
  id           Int      @id @default(autoincrement())
  name         String
  price        Decimal? @db.Decimal(10, 2)
  capacity     Int?
  price_per_gb Decimal? @db.Decimal(10, 3)
  type         String?
  cache        Int?
  form_factor  String?
  interface    String?
  imagen_url   String?
  tipo         String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_MemoriaInterna")
}

model mothers {
  id           Int      @id @default(autoincrement())
  name         String
  price        Decimal? @db.Decimal(10, 2)
  socket       String?
  form_factor  String?
  max_memory   Int?
  memory_slots Int?
  color        String?
  imagen_url   String?
  tipo         String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Mother")
}

model rams {
  id                 Int      @id @default(autoincrement())
  name               String
  price              Decimal? @db.Decimal(10, 2)
  speed_channels     Int?
  speed_mhz          Int?
  modules_qty        Int?
  module_capacity    Int?
  price_per_gb       Decimal? @db.Decimal(10, 3)
  color              String?
  first_word_latency Int?
  cas_latency        Int?
  imagen_url         String?
  tipo               String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Ram")
}

model sounds {
  id            Int      @id @default(autoincrement())
  name          String
  price         Decimal? @db.Decimal(10, 2)
  channels      String?
  digital_audio Int?
  snr           Int?
  sample_rate   Int?
  chipset       String?
  interface     String?
  imagen_url    String?
  tipo          String?

  publicaciones PublicacionProducto[] @relation("PublicacionProducto_Sound")
}

model ususarios {
  id_user          Int      @id @default(autoincrement())
  nombre           String   @db.VarChar
  apellido         String   @db.VarChar
  mail             String   @db.VarChar
  contrasenia      String   @db.VarChar
  fecha_nacimiento DateTime @db.Date
  permisos         Boolean?
  imagen_url       String?
  direccion        String?

  publicacionesUsuario PublicacionProducto[] @relation("PublicacionUsuario")
}

model vendedores {
  id_vendedor      Int      @id @default(autoincrement())
  nombre           String   @db.VarChar
  apellido         String   @db.VarChar
  mail             String   @db.VarChar
  contrasenia      String   @db.VarChar(50)
  fecha_nacimiento DateTime @db.Date
  cuil             BigInt?  @db.BigInt
  direccion        String
  descripcion      String?
  nombre_comercio  String?

  publicacionesVendedor PublicacionProducto[] @relation("PublicacionVendedor")
}

model PublicacionProducto {
  id            Int       @id @default(autoincrement())
  tipo_producto String

  // ——— FKs a cada tipo de producto ———
  cooler_id          Int?
  cpu_id             Int?
  fuente_id          Int?
  gabinete_id        Int?
  grafica_id         Int?
  memoria_externa_id Int?
  memoria_interna_id Int?
  mother_id          Int?
  ram_id             Int?
  sound_id           Int?

  usuario_id    Int?      
  vendedor_id   Int?
  creado_en     DateTime  @default(now())

  // ——— Relaciones hacia cada modelo ———
  cooler           coolers?           @relation("PublicacionProducto_Cooler",          fields: [cooler_id],          references: [id])
  cpu              cpus?              @relation("PublicacionProducto_Cpu",             fields: [cpu_id],             references: [id])
  fuente           fuentes?           @relation("PublicacionProducto_Fuente",          fields: [fuente_id],          references: [id])
  gabinete         gabinetes?         @relation("PublicacionProducto_Gabinete",        fields: [gabinete_id],        references: [id])
  grafica          graficas?          @relation("PublicacionProducto_Grafica",         fields: [grafica_id],         references: [id])
  memoria_externa  memorias_externas? @relation("PublicacionProducto_MemoriaExterna", fields: [memoria_externa_id], references: [id])
  memoria_interna  memorias_internas? @relation("PublicacionProducto_MemoriaInterna", fields: [memoria_interna_id], references: [id])
  mother           mothers?           @relation("PublicacionProducto_Mother",          fields: [mother_id],          references: [id])
  ram              rams?              @relation("PublicacionProducto_Ram",             fields: [ram_id],             references: [id])
  sound            sounds?            @relation("PublicacionProducto_Sound",           fields: [sound_id],           references: [id])

  usuario          ususarios?         @relation("PublicacionUsuario",                  fields: [usuario_id],         references: [id_user])
  vendedor         vendedores?        @relation("PublicacionVendedor",                 fields: [vendedor_id],        references: [id_vendedor])

  // ——— Índices para optimizar búsquedas por FK ———
  @@index([cooler_id],          name: "idx_publicacion_cooler_id")
  @@index([cpu_id],             name: "idx_publicacion_cpu_id")
  @@index([fuente_id],          name: "idx_publicacion_fuente_id")
  @@index([gabinete_id],        name: "idx_publicacion_gabinete_id")
  @@index([grafica_id],         name: "idx_publicacion_grafica_id")
  @@index([memoria_externa_id], name: "idx_publicacion_memoria_externa_id")
  @@index([memoria_interna_id], name: "idx_publicacion_memoria_interna_id")
  @@index([mother_id],          name: "idx_publicacion_mother_id")
  @@index([ram_id],             name: "idx_publicacion_ram_id")
  @@index([sound_id],           name: "idx_publicacion_sound_id")
  @@index([usuario_id],         name: "idx_publicacion_usuario_id")
  @@index([vendedor_id],        name: "idx_publicacion_vendedor_id")
}
